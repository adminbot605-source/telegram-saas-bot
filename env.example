# ─── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
CREATOR_USER_ID=5790665502
WEBHOOK_HOST=https://your-domain.com

# ─── Optional overrides ────────────────────────────────────────────────────────
BOT_USERNAME=@zarabot_botbot
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change_this_to_random_secret_string

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=saas_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=your_secure_password

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ─── App settings ──────────────────────────────────────────────────────────────
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
LOG_LEVEL=INFO
DEBUG=false
AUTO_MIGRATE=true

# ─── Access control ────────────────────────────────────────────────────────────
ACCESS_CACHE_TTL=3600
THROTTLE_RATE=0.3

# ─── High-load workers ─────────────────────────────────────────────────────────
DELETE_WORKERS=4
SHARD_COUNT=1
SHARD_ID=0

# ─── Business ──────────────────────────────────────────────────────────────────
PAYMENT_SUPPORT_USERNAME=@support
REFERRAL_BONUS_DAYS=7
